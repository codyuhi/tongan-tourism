<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cedar canvas behind the first frame; Compose draws everything after that. -->
    <style name="Theme.TonganTourism" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
    </style>
    <style name="Theme.TonganTourism.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TonganTourism</item>
    </style>
</resources>
